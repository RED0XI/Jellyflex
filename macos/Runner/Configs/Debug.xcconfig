#include "Warnings.xcconfig"

// Kein ENABLE_HARDENED_RUNTIME hier: Ad hoc signiert (ohne Team-ID) würde macOS dann die
// eingebetteten Frameworks (z. B. Ass.framework) nicht laden und die App stürzt beim Start ab.
// Die Hardened Runtime setzt tool/build_macos.sh beim Signieren mit der Developer ID
// (codesign --options runtime) – nur dort wird sie für die Notarisierung gebraucht.
